# AI Provider for resume generation ("openai" or "anthropic")
AI_PROVIDER=anthropic

# OpenAI API Key (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (if using Claude) - Recommended!
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Job Platform Credentials (optional, for authenticated scraping)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
INDEED_EMAIL=
INDEED_PASSWORD=

# Application Settings
AUTO_APPLY_DELAY=5
MAX_APPLICATIONS_PER_DAY=10
